{
  "expo": {
    "name": "ثروتي",
    "slug": "tharwati",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "tharwati",
    "version": "0.9.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "om.tharwati.tharwati",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "om.tharwati.tharwati",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0F513F",
        "foregroundImage": "./assets/brand/adaptive-fg.png",
        "backgroundImage": "./assets/brand/adaptive-bg.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0F513F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ثروتي يستخدم Face ID لقفل التطبيق وحماية بياناتك المالية."
        }
      ]
    ]
  }
}
