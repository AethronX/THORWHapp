{
  "expo": {
    "name": "ثروتي",
    "slug": "tharwati",
    "scheme": "tharwati",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "om.tharwati.tharwati"
    },
    "android": {
      "package": "om.tharwati.tharwati",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#034A37",
        "foregroundImage": "./assets/brand/adaptive-fg.png",
        "backgroundImage": "./assets/brand/adaptive-bg.png",
        "monochromeImage": "./assets/brand/monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#034A37"
        }
      ]
    ]
  }
}
