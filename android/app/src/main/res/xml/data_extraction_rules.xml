<?xml version="1.0" encoding="utf-8"?>
<!-- Tharwati v1 promises that financial data never leaves the device.
     Exclude everything from cloud backup and device-to-device transfer
     (Android 12+). Older versions are covered by allowBackup="false".
     Revisit when an explicit, user-initiated export/backup exists (P1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
